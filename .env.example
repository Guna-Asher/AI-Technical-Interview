# Copy to .env and adjust. Defaults in compose.yaml also work without a .env file.

# PostgreSQL (used by the postgres and backend services)
POSTGRES_USER=interview
POSTGRES_PASSWORD=change-me
POSTGRES_DB=interview

# Chroma (backend reaches it over the internal Docker network)
CHROMA_HOST=chroma
CHROMA_PORT=8000

# Browser-facing backend URL (NOT the Docker hostname "backend")
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Origins the backend allows for CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000

# OpenRouter. Required for resume profile extraction and question generation; the app starts without them.
# Use any chat model id from https://openrouter.ai/models. Never commit a real key.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Knowledge base (RAG). All optional; the defaults live in backend/app/config.py.
# Host folder with the technical PDFs, mounted read-only at /knowledge in the backend (default ./knowledge)
# KNOWLEDGE_HOST_DIR=./knowledge
# CHROMA_COLLECTION=knowledge
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# CHUNK_SIZE=800
# CHUNK_OVERLAP=150
# RETRIEVAL_TOP_K=5
# Minimum cosine similarity to return a chunk. An uncalibrated starting value, not a validated cutoff.
# RETRIEVAL_MIN_SCORE=0.25

# Resume upload and question generation (optional; defaults live in backend/app/config.py)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_TIMEOUT_SECONDS=60
# LLM_MAX_ATTEMPTS=2
# MAX_RESUME_BYTES=5242880
# MAX_RESUME_CHARS=20000
# QUESTION_COUNT=5
# CONTEXT_CHUNKS=8
# MIN_CONTEXT_CHUNKS=3
# MAX_RETRIEVAL_QUERIES=4
