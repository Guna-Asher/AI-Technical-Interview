# Copy to .env and adjust. Defaults in compose.yaml also work without a .env file.

# PostgreSQL (used by the postgres and backend services)
POSTGRES_USER=interview
POSTGRES_PASSWORD=change-me
POSTGRES_DB=interview

# Chroma (backend reaches it over the internal Docker network)
CHROMA_HOST=chroma
CHROMA_PORT=8000

# Browser-facing backend URL (NOT the Docker hostname "backend")
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Origins the backend allows for CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000

# OpenRouter (not needed until Phase 4; leave blank for now)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
